{
  "version": 8,
  "name": "ev-dashboard-seed",
  "metadata": {
    "ev-dashboard:notes": "首次启动时由 MapPackageManager.ensureSeed() 安装到 slot-A。‘mbtiles://tiles’ 是运行时占位,MapViewHolder.loadStyle() 会重写成绝对路径。"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": ["mbtiles://tiles"],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "sprite": "",
  "glyphs": "asset://fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0E1A2B"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#1E3A5F"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#173656",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#3FB6FF",
        "line-width": {
          "stops": [
            [8, 0.5],
            [12, 1.0],
            [16, 3.0]
          ]
        }
      }
    },
    {
      "id": "road_major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary"],
      "paint": {
        "line-color": "#58D5FF",
        "line-width": {
          "stops": [
            [6, 0.8],
            [12, 2.0],
            [16, 5.0]
          ]
        }
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#1B2E48",
        "fill-opacity": 0.65,
        "fill-outline-color": "#2B4769"
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#456EA3",
        "line-opacity": 0.5,
        "line-width": 0.6,
        "line-dasharray": [4, 2]
      }
    }
  ]
}
